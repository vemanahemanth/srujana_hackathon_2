# ==============================================================================
# FragilityShield Configuration Template (Sprint 4)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or paste API credentials, secrets, or database URLs into Git.

# ------------------------------------------------------------------------------
# 1. Deployment Mode & Environment
# ------------------------------------------------------------------------------
# Valid options: local_research, postgres_app, public_multi_tenant, production_cloud
DEPLOYMENT_MODE=local_research
APP_ENV=development

# Server Bind Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False

# ------------------------------------------------------------------------------
# 2. Database Configuration (Separated Migration & Runtime Roles)
# ------------------------------------------------------------------------------
# Runtime Application Role (Least-privilege DML, forced RLS, non-superuser, NOBYPASSRLS)
DATABASE_URL=postgresql://fragility_app_user:REPLACE_WITH_SECURE_APP_PASSWORD@localhost:5432/fragilityshield_db

# Dedicated Migration Role (DDL owner for Alembic migrations, never used by application API)
MIGRATION_DATABASE_URL=postgresql://fragility_migrator:REPLACE_WITH_SECURE_MIGRATOR_PASSWORD@localhost:5432/fragilityshield_db

# Connection Pool Settings
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=20

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security Settings
# ------------------------------------------------------------------------------
# Must be >= 32 characters long in production mode; rejects trivial defaults
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_32_BYTES_MIN
FRAGILITY_JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_32_BYTES_MIN
JWT_ISSUER=fragilityshield
JWT_AUDIENCE=fragilityshield-api
JWT_EXPIRATION_SECONDS=3600

# CORS Allowed Origins (Comma-separated; wildcard '*' strictly rejected in production)
ALLOWED_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Custom Model & Plugin Container Sandbox Settings
# ------------------------------------------------------------------------------
# Path to container runtime executable (docker, podman, or runsc)
CONTAINER_RUNTIME_PATH=/usr/local/bin/docker
SANDBOX_BASE_IMAGE=fragilityshield-sandbox-worker:latest

# Resource & Execution Ceilings
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_CPU_CORES=1.0
SANDBOX_TIMEOUT_SECONDS=5.0
SANDBOX_MAX_PIDS=32
SANDBOX_MAX_OUTPUT_BYTES=1048576

# ------------------------------------------------------------------------------
# 5. Upstox Market Data V3 Credentials (Optional)
# ------------------------------------------------------------------------------
UPSTOX_CLIENT_ID=your_upstox_client_id_here
UPSTOX_CLIENT_SECRET=your_upstox_client_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/oauth/callback
UPSTOX_ACCESS_TOKEN=your_upstox_jwt_access_token_here
UPSTOX_API_BASE_URL=https://api.upstox.com

# ------------------------------------------------------------------------------
# 6. Experiment Artifact Storage Settings (Sprint 5)
# ------------------------------------------------------------------------------
# Backend provider: local_filesystem, s3_compatible
ARTIFACT_STORAGE_BACKEND=local_filesystem
# Base directory for local filesystem storage (chroot directory root)
ARTIFACT_STORAGE_PATH=./data/artifacts
# Maximum allowed single artifact upload/write size in bytes (default 50 MB)
ARTIFACT_MAX_SIZE_BYTES=52428800

# S3 / MinIO / Object Storage Settings (when ARTIFACT_STORAGE_BACKEND=s3_compatible)
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# S3_BUCKET_NAME=fragilityshield-artifacts
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_REGION_NAME=ap-south-1

# ------------------------------------------------------------------------------
# 7. Asynchronous Experiment Worker Daemon Settings (Sprint 5)
# ------------------------------------------------------------------------------
WORKER_ID=worker_node_01
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LEASE_DURATION_SECONDS=30.0
WORKER_MAX_CONCURRENT_JOBS=1
WORKER_MAX_ATTEMPTS=3
WORKER_DEFAULT_TIMEOUT_SECONDS=60.0

